{
  "name": "videografer-portofolio",
  "version": "1.0.0",
  "description": "Showreel dan studio produksi video Bayu Pradana",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "prisma generate && tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:provision": "tsx server/provision.ts"
  },
  "keywords": [],
  "author": "guspriaman (guspriStack)",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "connect-pg-simple": "10.0.0",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "lucide-react": "1.77.0",
    "mediabunny": "1.66.2",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/guspristack/videografer-portofolio.git"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
